{
	"info": {
		"_postman_id": "gathering-ref-whitebox",
		"name": "Gathering Ref - White Box Testing (Cookie Auth)",
		"description": "Postman collection for White Box Testing (Basis Path Testing). Uses cookie-based authentication. Set up: Login via browser, get cookies from DevTools, then use Postman Interceptor or manually add cookies.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000"
		},
		{
			"key": "galleryId",
			"value": "YOUR_GALLERY_ID_HERE"
		},
		{
			"key": "imageId",
			"value": "YOUR_IMAGE_ID_HERE"
		},
		{
			"key": "sb-access-token",
			"value": ""
		},
		{
			"key": "sb-refresh-token",
			"value": ""
		}
	],
	"auth": {
		"type": "noauth"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Set cookies from environment variables for Supabase SSR auth",
					"const accessToken = pm.collectionVariables.get('sb-access-token') || pm.environment.get('sb-access-token');",
					"const refreshToken = pm.collectionVariables.get('sb-refresh-token') || pm.environment.get('sb-refresh-token');",
					"",
					"if (accessToken) {",
					"    pm.request.headers.add({ key: 'Cookie', value: `sb-access-token=${accessToken}` });",
					"}",
					"if (refreshToken) {",
					"    pm.request.headers.add({ key: 'Cookie', value: `sb-refresh-token=${refreshToken}` });",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "Prerequisites",
			"item": [
				{
					"name": "Setup: Get Cookies from Browser",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Setup Instructions', function() {",
									"    console.log('=== COOKIE-BASED AUTH SETUP ===');",
									"    console.log('1. Login to your app in Chrome browser');",
									"    console.log('2. Open DevTools (F12) > Application > Cookies');",
									"    console.log('3. Find these cookies:');",
									"    console.log('   - sb-access-token (starts with eyJ...)');",
									"    console.log('   - sb-refresh-token');",
									"    console.log('4. Copy the values and add them to your Postman environment');",
									"    console.log('');",
									"    console.log('OR use Postman Interceptor extension:');",
									"    console.log('1. Install Postman Interceptor in Chrome');",
									"    console.log('2. Enable interceptor in Postman');",
									"    console.log('3. Browse to your app and login');",
									"    console.log('4. Cookies will be captured automatically');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}",
							"host": ["{{baseUrl}}"]
						},
						"description": "Setup instructions for cookie-based authentication"
					}
				}
			]
		},
